{
  "name": "streamsense-dev-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "ai-voice-realtime",
    "chrome-extension",
    "session-dashboard"
  ],
  "dependencies": {
    "better-sqlite3": "13.0.2"
  },
  "scripts": {
    "build": "npm run build --workspace chrome-extension --workspace session-dashboard",
    "predemo": "npm run build",
    "demo": "npm run start --workspace ai-voice-realtime",
    "dev": "node scripts/dev-runner.js all",
    "dev:dashboard": "node scripts/dev-runner.js dashboard",
    "dev:realtime": "node scripts/dev-runner.js realtime",
    "test": "npm run check:orchestration",
    "check:orchestration": "node --test test/dev-plan.test.js test/process-supervisor.test.js test/check-runner.test.js",
    "check": "node scripts/check-runner.js"
  }
}
