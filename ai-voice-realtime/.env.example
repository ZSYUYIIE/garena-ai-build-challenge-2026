# Backend-only Gemini credential for Interactions, Live, and semantic embeddings.
# Never expose this value to the extension.
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Interactions model for atomic visual-change analysis and Deep Research
# query rewriting, answer synthesis, and microphone-question transcription.
GEMINI_VISION_MODEL=gemini-3.6-flash

# Gemini Live model for typed/open-microphone Q&A and native playback of Normal
# and Deep Research answers. It does not speak automatic timeline events.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Enables the optional, session-only Deep Research answer mode.
EXA_API_KEY=your_exa_api_key_here

# Cloud Speech-to-Text V2 uses Application Default Credentials supplied by the
# operator environment. Never place service-account JSON in this repository.
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_SPEECH_LOCATION=us

# Production allowlist: copy the exact ID displayed by chrome://extensions.
STREAMSENSE_EXTENSION_ID=your_32_character_chrome_extension_id

# Local development only. Opting in allows any syntactically valid Chrome
# extension origin, which a local process can spoof. Never enable in production.
STREAMSENSE_ALLOW_ANY_EXTENSION_ORIGIN=false

# Memory history selection:
# - auto: use MongoDB when MONGODB_URI is configured, otherwise empty memory;
# - mongodb: require MongoDB and fail startup if MONGODB_URI is missing;
# - memory: no-Mongo fallback. A configured URI still selects durable MongoDB
#   so Live and Memory cannot silently split into different stores.
STREAMSENSE_HISTORY_MODE=auto

# MongoDB stores durable sessions, accepted events plus embeddings, and the
# prototype dashboard profile. Paste the Atlas Drivers connection string and
# replace every placeholder. The database user is separate from the MongoDB
# Cloud login. URL-encode special characters in its password, and never commit
# the populated URI.
MONGODB_URI=mongodb+srv://YOUR_ATLAS_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_ATLAS_CLUSTER_HOSTNAME/?retryWrites=true&w=majority&appName=StreamSense
MONGODB_DB_NAME=streamsense

# Optional offline development alternative after `docker compose up -d mongodb`:
# MONGODB_URI=mongodb://localhost:27017

# Optional SQLite path for fast local realtime event evidence. Relative paths
# resolve from the backend process working directory.
# EVENT_DB_PATH=data/streamsense.db

HOST=127.0.0.1
PORT=8000
