# Backend-only Gemini credential. Never expose this value to the extension.
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Interactions model for atomic visual-change analysis.
GEMINI_VISION_MODEL=gemini-3.6-flash

# Gemini Live model for open-microphone Q&A and native voice playback.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Cloud Speech-to-Text V2 uses Application Default Credentials supplied by the
# operator environment. Never place service-account JSON in this repository.
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_SPEECH_LOCATION=us

# Production allowlist: copy the exact ID displayed by chrome://extensions.
STREAMSENSE_EXTENSION_ID=your_32_character_chrome_extension_id

# Local development only. Opting in allows any syntactically valid Chrome
# extension origin, which a local process can spoof. Never enable in production.
STREAMSENSE_ALLOW_ANY_EXTENSION_ORIGIN=false

# Historical dashboard data. `memory` starts empty and archives accepted events
# for the lifetime of this backend process. `demo` must be selected explicitly
# and is rejected when NODE_ENV=production.
STREAMSENSE_HISTORY_MODE=memory

# Dashboard prototype profiles are stored in MongoDB. For the recommended Atlas
# setup, paste the Drivers connection string and replace every placeholder. The
# database user is separate from your MongoDB Cloud login. URL-encode special
# characters in its password, and never commit the populated URI.
MONGODB_URI=mongodb+srv://YOUR_ATLAS_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_ATLAS_CLUSTER_HOSTNAME/?retryWrites=true&w=majority&appName=StreamSense
MONGODB_DB_NAME=streamsense

# Optional offline development alternative after `docker compose up -d mongodb`:
# MONGODB_URI=mongodb://localhost:27017

HOST=127.0.0.1
PORT=8000
